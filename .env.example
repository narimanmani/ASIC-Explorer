# History is disabled unless explicitly enabled with a private password and storage.
HISTORY_ENABLED=false
HISTORY_SITE_ORIGIN=http://127.0.0.1:4175
# Run npm run history:setup to generate a password hash and random signing secret.
HISTORY_PASSWORD_HASH=
HISTORY_SECRET=
# Heroku uses DATABASE_URL from its separately approved Postgres add-on.
DATABASE_URL=
# Local testing only; ignored on Heroku.
HISTORY_LOCAL=false
# HISTORY_LOCAL_FILE=.data/visitor-history.sqlite
# HISTORY_GEOIP_FILE=.data/dbip-city.mmdb
